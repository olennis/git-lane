{
  "name": "@olennis/git-lane",
  "version": "0.1.1",
  "description": "A focused Git lane TUI for local development workflows.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "git",
    "cli",
    "tui",
    "ink",
    "graph",
    "branch"
  ],
  "bin": {
    "git-lane": "dist/cli.js",
    "gln": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build && pnpm test",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
